# Copy to .dev.vars for local `wrangler dev` only. Never deploy these as production secrets via this file.
RESEND_API_KEY=re_xxx
EMAIL_TO=you@example.com
EMAIL_FROM=Portfolio <onboarding@resend.dev>
ALLOWED_ORIGIN=http://localhost:8080
ALLOW_DEV_RESET=true
DEV_RESET_SECRET=local-test-secret
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
ASK_SHIRLEY_RATE_MAX=30
# bcrypt hash only — generate with: npm run owner:hash-password
OWNER_PASSWORD_HASH=$2a$12$replace_me
# Optional Brave Search API key
# SEARCH_API_KEY=
# SEARCH_PROVIDER=brave
